{
  "name": "safereport",
  "version": "3.0.0",
  "private": true,
  "workspaces": ["frontend"],
  "scripts": {
    "setup": "npm install",
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w frontend",
    "typecheck": "npm run typecheck -w frontend",
    "db:push": "npm run db:push -w frontend",
    "db:seed": "npm run seed -w frontend",
    "db:studio": "npm run db:studio -w frontend",
    "postinstall": "prisma generate --schema frontend/prisma/schema.prisma || echo 'Prisma client not generated yet — run: npm run db:generate -w frontend'"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
