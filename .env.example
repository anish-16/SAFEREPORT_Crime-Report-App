[TEMPLATE]
# SafeReport — the ONE env file for the whole app (repo root).
# The app itself lives entirely in frontend/, so frontend/.env is honored too.

# Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# Signs the optional login tokens — long and random (e.g. openssl rand -hex 32)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Port the app binds to. Hosts (Render/Railway) set this for you.
PORT=3000

# ---- AI analysis (optional) -------------------------------------------------
# Paste any provider's key and every report is analyzed with that model.
# Usually set in-app instead: Settings → AI (stored encrypted in the DB).
# AI_API_KEY="sk-... or gsk_... or AIza... or sk-ant-..."
# AI_PROVIDER="openai"     # auto-detected from the key when omitted
# AI_MODEL="gpt-4o-mini"   # provider default when omitted
