# SafeReport — the ONE env file for the whole app (repo root).
# backend/.env is also still honored for split local dev (npm run dev:split).

# Neon PostgreSQL connection string (same database as the old project)
DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# Signs login tokens — make it long and random (e.g. openssl rand -hex 32)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Port the unified server binds to. Hosts (Render/Railway) set this for you.
PORT=3000

# Only needed if the UI is served from a different origin than /api
# CLIENT_ORIGIN="http://localhost:3000"
