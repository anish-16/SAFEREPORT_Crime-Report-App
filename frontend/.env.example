# Nothing is required here. The frontend talks to the API on the SAME origin
# (/api): the repo-root unified server handles both, and `next dev` proxies
# /api + /uploads to the backend on :4000 in split mode (npm run dev:split).
#
# Only set this for a split deploy WITHOUT the dev proxy (keep the /api suffix):
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
