[TEMPLATE]
# The frontend folder is the whole app: UI (Next.js), API (app/api/*),
# evidence uploads (app/uploads/*) and the AI analysis engine. Copy this to
# frontend/.env — the repo-root .env is honored as well.

# Neon PostgreSQL (Prisma schema lives in frontend/prisma/)
DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# Signs the optional login tokens (admin/moderator accounts)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Optional: use an env-provided AI key instead of the Settings → AI page
# AI_API_KEY="gsk_..."
# AI_PROVIDER="groq"
# AI_MODEL="llama-3.3-70b-versatile"
